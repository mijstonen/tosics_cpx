        static bool
    IsDirective(string const &_char _line)
    // detect lines that start with #
    // eventually precedded by whitespace(s)
    // regexp equivalent of ^\s*#\s.*$
    {
        auto pc= _line;
        while ( *pc ) /*1*/{
            switch ( pc ) /*2*/{
                case '#' :
                    // There are more fields, separated by whitespace,
                    // so we expect next at least one whitespace to confirm directive detection.
                    switch ( ++pc ) {
                        case ' ':
                        case '\t':
                            return true;
                        default:
                            // another directive not the kind of directive we are looking for  (aka #pragma)
                            return false;
                    }
                case ' ':
                case '\t':
                    ++pc;
                    continue; // to iterate to next character
                default:
                    // anything else including empty strings
                    return false;
            }// switch 2
        } // switch 1
    }

    inline constexpr // signed byte
int8_t operator "" _sb(long double _literal) noexcept
{
    return int8_t(_literal);
}


class Line : public string {

    public:
    Line(const string& _line) : string(_line)
    {
    }

        auto
    get(istream& _in) -> decltype(std::getline(istream,string))
    {
        return getline(_in,*this);
    }

    operator string() const
    {
        return *this;
    }
        bool
    has_contents() const
    // detects when the line has content that are interpretable as fields by getFields()
    // that is it should not be empty or only contain whitespaces
    {
        auto end_line{ end(*this) };
        // becomses true when any non white space is detected before the end of line
        bool return_value { find_if_not( begin( *this), end_line, isspace)!= end_line };
        return return_value;
    }

            //auto end_line{ end(_line) };
        // becomses true when any non white space is detected before the end of line
        //bool return_value { find_if_not( begin( _line), end_line, isspace)!= end_line };
        //return return_value;


};


    for (auto c: _line) {
        if ( isspace(c)) {
            continue;
        }
        return true;
    }}
    return false;

            auto
    indentPrint=[&indentspaces,includeLevel]()
    {
        // Temporary change the string length by overwriting a space with end of string marker
        // on the desired position. After printing the space character is restored,
        // so that indentspaces can be reused next time.
        auto eos_position=max(decltype(includeLevel)(MAX_INDENTS),includeLevel)*SPACES_PER_INDENT;
        // ensure eos_position< indentspaces.size()), we did by having...
        //    SPACES_PER_INDENT extra spaces larger then eos_position can become.
//        char* exposed_indentspaces=indentspaces.data();
//        char& changedChar{exposed_indentspaces[eos_position]};
//        changedChar='\0';
//         puts(exposed_indentspaces);
//        changedChar=' ';

        while(-- eos_position) putchar(' ');


    };

    string indentspaces{<?='"'.str_repeat(" ",SPACES_PER_INDENT*(MAX_INDENTS+1)).'"'?>};
        auto
    symmetryCount{ [&symmetry](string const& _line) -> string
    // ensure that there are no C/++ comments in the file
    // cant de < and > of template because these also work indiviually as less and more then, in expressions
    {
        bool sqtogle{false};
        bool dqtogle{false};
        ostringstream decorated_line;
        string word="";

                auto
            flush_word{[&]()
            {
#if 1
                if ( word.size() ) {
                    bool is_keyword = C_plus_plus_keywords.find(word)!=C_plus_plus_keywords.end();
                    char const* wordColor= NOCOLOR;
                    if ( is_keyword ) {
                        wordColor= HWHITE;
                    }
                    else if ( isdigit(word[0]) ) {
                        wordColor= HMAGENTA;
                    }
                    else {
                        wordColor= NOCOLOR;
                    }
                    decorated_line<< wordColor<< word<< NOCOLOR;
                    word="";
                }
#endif
            }};


        for(auto c: _line) {
            if      ( !sqtogle &&  c=='"' ) {
                dqtogle= !dqtogle;
            }
            else if ( !dqtogle &&  c=='\'' ) {
                sqtogle= !sqtogle;
            }
            auto sdqColor = sqtogle ?HMAGENTA
                          : dqtogle ?HBLUE
                          : NOCOLOR
                          ;

            if ( sqtogle || dqtogle ) {
                decorated_line<< sdqColor<< c;
                continue;
            }

            if ( strchr("({[",c) ) {
                flush_word();
                decorated_line<< HCYAN<< c<< NOCOLOR;
                ++symmetry;
                continue;
            }
            if ( strchr(")}]",c) ) {
                flush_word();
                decorated_line<< HCYAN<< c<< NOCOLOR;
                --symmetry;
                continue;
            }
            if ( strchr(",;%&*->.<+=|\\/?:`~!@#$\"'" ,c) ) {
                flush_word();
                decorated_line<< HYELLOW<< c<< NOCOLOR;
                continue;
            }
            if ( isspace(c) ) {
                flush_word();
                decorated_line<< c;
                continue;
            }
            word+= c;

            //decorated_line<< c;
        } // for c
        flush_word();


        auto return_value=decorated_line.str();
        //INFO(VARVAL(return_value));
        return return_value;
    }};

